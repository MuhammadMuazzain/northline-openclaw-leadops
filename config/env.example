# Copy to repo root as .env
NORTHLINE_DB_PATH=data/northline_crm.sqlite3
NORTHLINE_SAMPLE_PATH=data/samples/public_listings.jsonl
# Optional: set to 1 to attempt live HTTP website checks
NORTHLINE_LIVE_WEBSITE_CHECK=0
# gog must be authenticated separately for real Gmail/Sheets
GOG_SHEET_ID=
OUTREACH_FROM_NAME=Northline Home Services
OUTREACH_REPLY_TO=
